        "size_comp = os.path.getsize(compressed_video_path)\n",
        "\n",
        "# 3. Extract a matching frame (Frame 15) from both original and compressed videos\n",
        "def extract_frame_15(path):\n",
        "    cap = cv2.VideoCapture(path)\n",
        "    frame_15 = None\n",
        "    frame_idx = 0\n",
        "    while cap.isOpened():\n",
        "        ret, frame = cap.read()\n",
        "        if not ret:\n",
        "            break\n",
        "        if frame_idx == 15:\n",
        "            frame_15 = frame.copy()\n",
        "            break\n",
        "        frame_idx += 1\n",
        "    cap.release()\n",
        "    return frame_15\n",
        "\n",
        "frame_orig = extract_frame_15('sample_video.mp4')\n",
        "frame_comp = extract_frame_15(compressed_video_path)\n",
        "\n",
        "# 4. Calculate MSE and PSNR\n",
        "def calculate_mse(imageA, imageB):\n",
        "    err = np.sum((imageA.astype(\"float\") - imageB.astype(\"float\")) ** 2)\n",
        "    err /= float(imageA.shape[0] * imageA.shape[1] * imageA.shape[2])\n",
