        "import os\n",
        "\n",
        "# 1. Compress image in memory using PNG (lossless) and JPEG (lossy, quality=10)\n",
        "# PNG compression\n",
        "success_png, encoded_png = cv2.imencode('.png', img)\n",
        "if not success_png:\n",
        "    raise ValueError(\"PNG encoding failed\")\n",
        "\n",
        "# JPEG compression with low quality\n",
        "success_jpg, encoded_jpg = cv2.imencode('.jpg', img, [int(cv2.IMWRITE_JPEG_QUALITY), 10])\n",
        "if not success_jpg:\n",
        "    raise ValueError(\"JPEG encoding failed\")\n",
        "\n",
        "# Save files to disk to compare file sizes\n",
        "png_path = 'compressed_lossless.png'\n",
        "jpg_path = 'compressed_lossy.jpg'\n",
        "with open(png_path, 'wb') as f:\n",
        "    f.write(encoded_png)\n",
        "with open(jpg_path, 'wb') as f:\n",
        "    f.write(encoded_jpg)\n",
        "\n",
        "# 2. Decode/reconstruct the images back\n",
        "img_png_decoded = cv2.imdecode(encoded_png, cv2.IMREAD_GRAYSCALE)\n",
        "img_jpg_decoded = cv2.imdecode(encoded_jpg, cv2.IMREAD_GRAYSCALE)\n",
        "\n",
        "# 3. Define MSE and PSNR functions\n",
        "def calculate_mse(imageA, imageB):\n",
        "    err = np.sum((imageA.astype(\"float\") - imageB.astype(\"float\")) ** 2)\n",
        "    err /= float(imageA.shape[0] * imageA.shape[1])\n",
        "    return err\n",
        "\n",
        "def calculate_psnr(imageA, imageB):\n",
        "    mse = calculate_mse(imageA, imageB)\n",
        "    if mse == 0:\n",
        "        return float('inf')\n",
        "    max_pixel = 255.0\n",
        "    return 20 * np.log10(max_pixel / np.sqrt(mse))\n",
        "\n",
        "# Compute metrics\n",
        "mse_png = calculate_mse(img, img_png_decoded)\n",
        "psnr_png = calculate_psnr(img, img_png_decoded)\n",
        "size_png = os.path.getsize(png_path)\n",
        "\n",
        "mse_jpg = calculate_mse(img, img_jpg_decoded)\n",
        "psnr_jpg = calculate_psnr(img, img_jpg_decoded)\n",
        "size_jpg = os.path.getsize(jpg_path)\n",
        "size_orig = os.path.getsize(image_path)\n",
        "\n",
        "print(f\"Original Image Size: {size_orig} bytes\")\n",
        "print(f\"PNG (Lossless) - Size: {size_png} bytes, MSE: {mse_png:.4f}, PSNR: {psnr_png:.2f} dB\")\n",
        "print(f\"JPEG (Lossy) - Size: {size_jpg} bytes, MSE: {mse_jpg:.4f}, PSNR: {psnr_jpg:.2f} dB\")\n",
        "\n",
        "# 4. Display comparison side-by-side using Matplotlib\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 6))\n",
        "\n",
        "# Original Image\n",
        "axes[0].imshow(img, cmap='gray')\n",
        "axes[0].set_title(f'Original Grayscale\\nSize: {size_orig} bytes')\n",
        "axes[0].axis('off')\n",
        "\n",
        "# PNG Reconstructed\n",
        "axes[1].imshow(img_png_decoded, cmap='gray')\n",
        "axes[1].set_title(f'PNG Lossless Reconstructed\\nSize: {size_png} bytes\\nMSE: {mse_png:.4f}, PSNR: {psnr_png:.2f} dB')\n",
        "axes[1].axis('off')\n",
        "\n",
        "# JPEG Reconstructed\n",
        "axes[2].imshow(img_jpg_decoded, cmap='gray')\n",
        "axes[2].set_title(f'JPEG Lossy (Q=10) Reconstructed\\nSize: {size_jpg} bytes\\nMSE: {mse_jpg:.4f}, PSNR: {psnr_jpg:.2f} dB')\n",
        "axes[2].axis('off')\n",
        "\n",
        "plt.tight_layout()\n",
        "compression_comparison_file = 'compression_comparison.png'\n",
        "plt.savefig(compression_comparison_file, dpi=300)\n",
        "plt.show()\n"
      ],
