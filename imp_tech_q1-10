        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import urllib.request\n",
        "\n",
        "# 1. Download and load a sample image in grayscale with a custom User-Agent to avoid 403 Forbidden\n",
        "url = 'https://upload.wikimedia.org/wikipedia/commons/e/ec/Soccer_kick_Waddell.jpg'\n",
        "image_path = 'sample_image.jpg'\n",
        "\n",
        "req = urllib.request.Request(\n",
        "    url,\n",
        "    headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3'}\n",
        ")\n",
        "\n",
        "try:\n",
        "    with urllib.request.urlopen(req) as response, open(image_path, 'wb') as out_file:\n",
        "        out_file.write(response.read())\n",
        "except Exception as e:\n",
        "    print(f\"Failed to download image from primary URL: {e}\")\n",
        "    # Fallback to creating a synthetic image if download fails completely\n",
        "    synthetic = np.zeros((400, 400), dtype=np.uint8)\n",
        "    cv2.circle(synthetic, (200, 200), 100, 255, -1)\n",
        "    cv2.rectangle(synthetic, (50, 50), (150, 150), 255, -1)\n",
        "    cv2.imwrite(image_path, synthetic)\n",
        "\n",
        "# Load in grayscale\n",
        "img = cv2.imread(image_path, cv2.IMREAD_GRAYSCALE)\n",
        "if img is None:\n",
        "    raise FileNotFoundError(\"Failed to load the image.\")\n",
        "\n",
        "# 2. Apply Sobel operators\n",
        "# Use CV_64F to avoid overflow/underflow, then take the absolute value\n",
        "sobel_x = cv2.Sobel(img, cv2.CV_64F, 1, 0, ksize=3)\n",
        "sobel_y = cv2.Sobel(img, cv2.CV_64F, 0, 1, ksize=3)\n",
        "\n",
        "# Calculate combined magnitude\n",
        "sobel_magnitude = np.sqrt(sobel_x**2 + sobel_y**2)\n",
        "\n",
        "# Normalize and convert to 8-bit unsigned integer\n",
        "abs_sobel_x = cv2.convertScaleAbs(sobel_x)\n",
        "abs_sobel_y = cv2.convertScaleAbs(sobel_y)\n",
        "\n",
        "# Normalize magnitude to 0-255 range and convert to uint8\n",
        "sobel_magnitude_normalized = cv2.normalize(sobel_magnitude, None, 0, 255, cv2.NORM_MINMAX)\n",
        "abs_sobel_magnitude = np.uint8(sobel_magnitude_normalized)\n",
        "\n",
        "# 3. Apply Canny edge detector\n",
        "canny_edges = cv2.Canny(img, threshold1=50, threshold2=150)\n",
        "\n",
        "# 4. Plot side-by-side comparison using Matplotlib\n",
        "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
        "\n",
        "# Flatten axes for easier iteration\n",
        "axes = axes.ravel()\n",
        "\n",
        "# Original Image\n",
        "axes[0].imshow(img, cmap='gray')\n",
        "axes[0].set_title('Original Grayscale Image')\n",
        "axes[0].axis('off')\n",
        "\n",
        "# Sobel X\n",
        "axes[1].imshow(abs_sobel_x, cmap='gray')\n",
        "axes[1].set_title('Sobel X Gradient')\n",
        "axes[1].axis('off')\n",
        "\n",
        "# Sobel Y\n",
        "axes[2].imshow(abs_sobel_y, cmap='gray')\n",
        "axes[2].set_title('Sobel Y Gradient')\n",
        "axes[2].axis('off')\n",
        "\n",
        "# Sobel Magnitude\n",
        "axes[3].imshow(abs_sobel_magnitude, cmap='gray')\n",
        "axes[3].set_title('Combined Sobel Magnitude')\n",
        "axes[3].axis('off')\n",
        "\n",
        "# Canny Edges\n",
        "axes[4].imshow(canny_edges, cmap='gray')\n",
        "axes[4].set_title('Canny Edge Detection')\n",
        "axes[4].axis('off')\n",
        "\n",
        "# Hide the last empty subplot\n",
        "axes[5].axis('off')\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "# 5. Save the comparison plot as an image file\n",
        "comparison_file = 'edge_detection_comparison.png'\n",
        "plt.savefig(comparison_file, dpi=300)\n",
        "plt.show()\n",
        "\n",
        "print(f\"Successfully saved comparison plot to: {comparison_file}\")"
      ],
