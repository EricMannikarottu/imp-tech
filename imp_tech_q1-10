        "import cv2\n",
        "import os\n",
        "\n",
        "# 1. Open original video to get properties\n",
        "cap_orig = cv2.VideoCapture(video_path)\n",
        "if not cap_orig.isOpened():\n",
        "    raise FileNotFoundError(\"Failed to open original video.\")\n",
        "\n",
        "orig_fps = cap_orig.get(cv2.CAP_PROP_FPS)\n",
        "orig_width = int(cap_orig.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "orig_height = int(cap_orig.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "orig_total_frames = int(cap_orig.get(cv2.CAP_PROP_FRAME_COUNT))\n",
        "\n",
        "# 2. Define downsampling factor and target output\n",
        "N = 3  # Keep every 3rd frame\n",
        "sampled_video_path = 'sampled_video.mp4'\n",
        "sampled_fps = orig_fps / N\n",
        "\n",
        "fourcc_sampled = cv2.VideoWriter_fourcc(*'mp4v')\n",
        "out_sampled = cv2.VideoWriter(sampled_video_path, fourcc_sampled, sampled_fps, (orig_width, orig_height), isColor=True)\n",
        "\n",
        "orig_count = 0\n",
        "sampled_count = 0\n",
        "\n",
        "# 3. Process frames and write every N-th frame\n",
        "while cap_orig.isOpened():\n",
        "    ret, frame = cap_orig.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    if orig_count % N == 0:\n",
        "        out_sampled.write(frame)\n",
        "        sampled_count += 1\n",
        "\n",
        "    orig_count += 1\n",
        "\n",
        "cap_orig.release()\n",
        "out_sampled.release()\n",
        "\n",
        "# 4. Compare file sizes and frame counts\n",
        "orig_file_size = os.path.getsize(video_path)\n",
        "sampled_file_size = os.path.getsize(sampled_video_path)\n",
        "\n",
        "print(f\"Original Video ({video_path}):\")\n",
        "print(f\"  - Total Frames: {orig_count} (Cap property reported: {orig_total_frames})\")\n",
        "print(f\"  - FPS: {orig_fps}\")\n",
        "print(f\"  - File Size: {orig_file_size} bytes\")\n",
        "\n",
        "print(f\"\\nDownsampled Video ({sampled_video_path}):\")\n",
