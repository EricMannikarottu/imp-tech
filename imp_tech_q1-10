        "import cv2\n",
        "import numpy as np\n",
        "import os\n",
        "\n",
        "# 1. Open original video to retrieve properties\n",
        "cap = cv2.VideoCapture(video_path)\n",
        "if not cap.isOpened():\n",
        "    raise FileNotFoundError(\"Failed to open original video for transformations.\")\n",
        "\n",
        "orig_fps = cap.get(cv2.CAP_PROP_FPS)\n",
        "width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "\n",
        "# 2. Initialize VideoWriter for transformed video\n",
        "transformed_video_path = 'transformed_video.mp4'\n",
        "fourcc_trans = cv2.VideoWriter_fourcc(*'mp4v')\n",
        "out_trans = cv2.VideoWriter(transformed_video_path, fourcc_trans, orig_fps, (width, height), isColor=True)\n",
        "\n",
        "frame_idx = 0\n",
        "while cap.isOpened():\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    # A. Translation (Shift right by 20 pixels, down by 10 pixels)\n",
        "    tx, ty = 20, 10\n",
        "    M_translation = np.float32([[1, 0, tx], [0, 1, ty]])\n",
        "    translated_frame = cv2.warpAffine(frame, M_translation, (width, height))\n",
        "\n",
        "    # B. Rotation (Rotate by 45 degrees around center)\n",
        "    center = (width // 2, height // 2)\n",
        "    angle = 45\n",
        "    scale = 1.0\n",
