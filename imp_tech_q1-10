        "import cv2\n",
        "import os\n",
        "import numpy as np\n",
        "\n",
        "# 1. Create a synthetic video 'sample_video.mp4'\n",
        "video_path = 'sample_video.mp4'\n",
        "frame_width = 400\n",
        "frame_height = 400\n",
        "fps = 10\n",
        "num_frames = 30\n",
        "\n",
        "fourcc = cv2.VideoWriter_fourcc(*'mp4v')\n",
        "out = cv2.VideoWriter(video_path, fourcc, fps, (frame_width, frame_height), isColor=True)\n",
        "\n",
        "for i in range(num_frames):\n",
        "    # Create a black frame\n",
        "    frame = np.zeros((frame_height, frame_width, 3), dtype=np.uint8)\n",
        "    # Calculate circle position moving diagonally\n",
        "    center_x = int(50 + (i / num_frames) * 300)\n",
        "    center_y = int(50 + (i / num_frames) * 300)\n",
        "    # Draw a green circle\n",
        "    cv2.circle(frame, (center_x, center_y), 30, (0, 255, 0), -1)\n",
        "    out.write(frame)\n",
        "\n",
        "out.release()\n",
        "print(f\"Successfully created synthetic video: {video_path}\")\n",
        "\n",
        "# 2. Extract frames sequentially\n",
        "output_dir = 'extracted_frames'\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "cap = cv2.VideoCapture(video_path)\n",
        "extracted_count = 0\n",
        "\n",
        "while cap.isOpened():\n",
        "    ret, frame = cap.read()\n",
        "    if not ret:\n",
        "        break\n",
        "\n",
        "    # Construct filename and save frame\n",
        "    frame_filename = os.path.join(output_dir, f\"frame_{extracted_count:03d}.png\")\n",
        "    cv2.imwrite(frame_filename, frame)\n",
        "    extracted_count += 1\n",
        "\n",
        "cap.release()\n",
        "print(f\"Successfully extracted {extracted_count} frames to directory: {output_dir}\")"
